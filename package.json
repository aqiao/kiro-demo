{
  "name": "online-chat-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint src --max-warnings 0",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "quality:gate": "uv run python -m scripts.check_quality_gate",
    "serve:production": "APP_ENV=production uv run gunicorn --config gunicorn.conf.py"
  },
  "dependencies": {
    "vue": "3.5.13"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "@playwright/test": "^1.56.1",
    "@vitejs/plugin-vue": "5.2.1",
    "@vue/test-utils": "2.4.6",
    "eslint": "9.17.0",
    "jsdom": "25.0.1",
    "vite": "6.0.5",
    "vitest": "2.1.8"
  }
}
